॥ ५. द्रुत-निर्णय-यन्त्रम् (Single Forward Pass System 1 Decision Engine) ॥
संरचना द्रुत_यन्त्र
    तापमानम्: अंश६४।
इति

विधान द्रुत_यन्त्र
    क्रिया गणना(स्व, प्र: ऋण प्रश्न, पाठ: ऋण सूत्र) -> उत्तर_फलित
        मान लघु_पाठ = सूत्र_लघु(पाठ)।
        मान विकल्प_संख्या = सूची_दैर्घ्यम्(प्र.विकल्पाः)।
        मान विकार्य स्कोर_सूची = सूची_सृज(विकल्प_संख्या, ०.०)।

        मान विकार्य व_सू = ०।
        यावत् व_सू < विकल्प_संख्या
            मान वि = प्र.विकल्पाः[व_सू]।
            मान विकार्य मान_योग = वि.आधार_भार।

            ॥ संकेतानां मेलनम् (Match semantic cues) ॥
            मान संकेत_शब्दाः = सूत्र_विभाजय(वि.संकेताः, ",")।
            मान श_दैर्घ्य = सूची_दैर्घ्यम्(संकेत_शब्दाः)।
            मान विकार्य श_सू = ०।
            यावत् श_सू < श_दैर्घ्य
                मान शब्द = संकेत_शब्दाः[श_सू]।
                मान ल_शब्द = सूत्र_लघु(ऋण शब्द)।
                यदि सूत्र_अन्वेषण(ऋण लघु_पाठ, ऋण ल_शब्द)
                    मान_योग = मान_योग + २.५।
                इति
                श_सू = श_सू + १।
            इति

            स्कोर_सूची[व_सू] = मान_योग।
            व_सू = व_सू + १।
        इति

        ॥ तापमान-आधारित-मृदु-महत्तम (Temperature Scaled Softmax) ॥
        मान विकार्य घाताङ्क_योग = ०.०।
        मान विकार्य सम्भावना_सूची = सूची_सृज(विकल्प_संख्या, ०.०)।
        मान विकार्य स_सू = ०।
        यावत् स_सू < विकल्प_संख्या
            मान रूपान्तरित = स्कोर_सूची[स_सू] / स्व.तापमानम्।
            मान घ = घाताङ्क(रूपान्तरित)।
            सम्भावना_सूची[स_सू] = घ।
            घाताङ्क_योग = घाताङ्क_योग + घ।
            स_सू = स_सू + १।
        इति

        मान विकार्य महत्तम_सम्भावना = ०.०।
        मान विकार्य महत्तम_सूचक = ०।
        मान विकार्य न_सू = ०।
        यावत् न_सू < विकल्प_संख्या
            सम्भावना_सूची[न_सू] = सम्भावना_सूची[न_सू] / घाताङ्क_योग।
            मान वर्तमान = सम्भावना_सूची[न_सू]।
            यदि वर्तमान > महत्तम_सम्भावना
                महत्तम_सम्भावना = वर्तमान।
                महत्तम_सूचक = न_सू।
            इति
            न_सू = न_सू + १।
        इति

        मान चयनित_वि = प्र.विकल्पाः[महत्तम_सूचक]।
        मान विकार्य सत्य_मान = मिथ्या।
        यदि प्र.प्रकार == २
            यदि महत्तम_सूचक == १
                सत्य_मान = सत्यम्।
            इति
        इति

        ॥ ब्रियर-मान-गणना (Brier Score for Calibration Quality: (1 - P)^2) ॥
        मान ब्रियर = (१.० - महत्तम_सम्भावना) * (१.० - महत्तम_सम्भावना)।

        प्रति उत्तर_फलित(
            प्रश्न_नाम: सूत्र_अंश(प्र.प्रश्न_नाम, ०, सूत्र_दैर्घ्यम्(प्र.प्रश्न_नाम)),
            प्रकार: प्र.प्रकार,
            चयनम्: सूत्र_अंश(चयनित_वि.नाम, ०, सूत्र_दैर्घ्यम्(चयनित_वि.नाम)),
            वर्णनम्: सूत्र_अंश(चयनित_वि.वर्णनम्, ०, सूत्र_दैर्घ्यम्(चयनित_वि.वर्णनम्)),
            अङ्क: महत्तम_सूचक,
            सत्यता: सत्य_मान,
            विश्वास: महत्तम_सम्भावना,
            ब्रियर_मान: ब्रियर,
            सम्भावनाः: सम्भावना_सूची
        )।
    इति
इति

